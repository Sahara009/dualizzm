# Скопируй в .env.local и заполни.

# Адрес сайта (нужен для возврата после оплаты)
SITE_URL=http://localhost:3000

# Админ-панель: /admin
ADMIN_PASSWORD=поменяй-меня
# Любая длинная случайная строка (32+ символа) для подписи сессии
AUTH_SECRET=поменяй-на-длинную-случайную-строку-минимум-32-символа

# Оплата через ЮKassa. Пока ключей нет, работает тестовая оплата-заглушка.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Чеки по 54-ФЗ через ЮKassa (нужна онлайн-касса). Поставь 1, если продавец — ИП с кассой.
# Самозанятым оставь пустым: они выдают чеки через «Мой налог» (или сервис чеков самозанятых в ЮKassa).
YOOKASSA_RECEIPTS=
